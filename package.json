{
  "name": "voice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "ws": "tsx --env-file-if-exists=.env.local server/ws-server.ts",
    "dev:all": "concurrently -n next,ws -c cyan,magenta \"npm:dev\" \"npm:ws\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepgram/sdk": "^5.8.0",
    "better-sqlite3": "^13.0.3",
    "next": "16.3.1",
    "openai": "^7.4.0",
    "pdf-parse": "^2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "twilio": "^6.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
