OPENAI_API_KEY=
# Optional overrides
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Speech (Deepgram) ---
# API key from https://console.deepgram.com. Drives both halves of the call:
# streaming speech-to-text in and Aura text-to-speech out. Without it the media
# server answers, records the call, and then says nothing at all.
DEEPGRAM_API_KEY=
# Optional overrides. Both sides run μ-law at 8 kHz to match Twilio exactly, so
# no audio is ever resampled; only the model names are worth changing.
# DEEPGRAM_STT_MODEL=nova-3
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# Silence (ms) after which Deepgram calls the end of a turn, and the word-gap
# (ms) after which it sends a separate UtteranceEnd. Lower endpointing means a
# snappier agent and more chance of it talking over a caller who paused.
# DEEPGRAM_ENDPOINTING_MS=300
# DEEPGRAM_UTTERANCE_END_MS=1000

# --- Barge-in tuning ---
# How much the caller has to say before the agent stops talking over them.
# Too low and a cough cuts the agent off mid-sentence; too high and the agent
# feels deaf. Expect to tune these against real calls.
# BARGE_IN_MIN_WORDS=2
# BARGE_IN_MIN_CHARS=5
# BARGE_IN_MIN_CONFIDENCE=0.6

# --- Voice provider ---
# Which vendor carries phone calls: "twilio" (default) or "vapi". A value that
# is neither is rejected at startup rather than silently falling back, since
# calling out through the wrong vendor is not something to discover later.
# VOICE_PROVIDER=twilio

# --- Phone calls (Twilio Media Streams) ---
# Account SID and Auth Token from https://console.twilio.com. The auth token
# also verifies the X-Twilio-Signature on the /api/twilio/voice webhook, so a
# wrong value shows up as every inbound call being rejected with 403.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number calls are placed from, E.164 (e.g. +14155551234).
TWILIO_FROM_NUMBER=
# Public HTTPS origin Twilio reaches this Next app on (a cloudflared tunnel to
# port 3000). Also the URL the webhook signature is checked against, so it must
# match the URL configured on the Twilio number exactly. No trailing slash.
PUBLIC_BASE_URL=
# Public wss:// origin of the media WebSocket server (server/ws-server.ts).
# Separate from PUBLIC_BASE_URL because a cloudflared quick tunnel maps one
# port only: Next (3000) and the WS server (3001) each need their own tunnel.
# Run ./tunnels.sh to start both and print the two URLs. No trailing slash.
# Twilio accepts wss:// only.
PUBLIC_WS_URL=
# Port the media WebSocket server listens on. Defaults to 3001.
# WS_PORT=3001
# Set to 1 to echo the caller's own audio back to them, which proves the media
# stream is bidirectional. Leave unset once the real pipeline is in place.
# ECHO_TEST=1
# Set to 1 to replace Deepgram with the offline stand-ins in
# server/fake-providers.ts. The recogniser keys off real audio energy and the
# synthesiser emits real μ-law, so the pipeline can be driven end to end with no
# Deepgram account. For tests only — never set this on a real phone number.
# VOICE_FAKE_PROVIDERS=1

# --- Phone calls (Vapi) ---
# Only needed when VOICE_PROVIDER=vapi. Vapi runs the call itself — transcriber,
# turn-taking and voice — and calls this app back for the thinking, so
# DEEPGRAM_API_KEY and PUBLIC_WS_URL play no part on this path. PUBLIC_BASE_URL
# does: it is the origin Vapi reaches both callbacks on, and it must be the
# Next tunnel (port 3000), not the WebSocket one.
# Private API key from https://dashboard.vapi.ai (the private one, not the
# public web key — the public key cannot create assistants or place calls).
VAPI_API_KEY=
# The id of the Vapi phone number to call from and answer on. An id, not a
# number: `GET https://api.vapi.ai/phone-number` lists them.
VAPI_PHONE_NUMBER_ID=
# Any long random string, e.g. `openssl rand -hex 32`. It is written onto the
# assistant Vapi stores for each agent and sent back to
# /api/vapi/<id>/chat/completions and /api/vapi/events, which reject anything
# that does not match. Changing it takes effect on each agent's next outbound
# call, when its assistant is re-synced.
VAPI_SECRET=
